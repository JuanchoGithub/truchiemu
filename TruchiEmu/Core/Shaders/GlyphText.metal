struct GlyphTextUniforms {
    float cellSize;       // source pixels per character cell
    float contrast;       // luma contrast around 0.5
    float gamma;          // luma gamma
    float brightness;     // glyph brightness
    float saturation;     // color-mode saturation
    float background;     // background level (0 = black)
    float colorMode;      // 0 = source color, 1 = green, 2 = amber, 3 = white
    float glyphSet;       // 0 = ASCII, 1 = Extended, 2 = Blocks
    float4 sourceSize;    // (w, h, 1/w, 1/h)
    float4 outputSize;    // (w, h, 1/w, 1/h)
};

fragment float4 fragmentGlyphText(VertexOut in [[stage_in]],
                                  texture2d<float> tex [[texture(0)]],
                                  constant GlyphTextUniforms &u [[buffer(0)]]) {
    constexpr sampler s(filter::linear, address::clamp_to_edge, mip_filter::none);

    float cell = max(u.cellSize, 0.1);
    float2 sourcePx = in.texCoord * u.sourceSize.xy;
    float2 cellIndex = floor(sourcePx / cell);
    float2 cellCenter = (cellIndex + 0.5) * cell / u.sourceSize.xy;

    float3 src = tex.sample(s, cellCenter).rgb;

    float luma = dot(src, float3(0.299, 0.587, 0.114));
    luma = saturate((luma - 0.5) * u.contrast + 0.5);
    luma = pow(luma, u.gamma);

    int glyphSet = clamp(int(u.glyphSet + 0.5), 0, 2);
    int rampCount = int(kGlyphRampCounts[glyphSet]);
    int rampOffset = int(kGlyphRampOffsets[glyphSet]);
    // Vary the glyph inside a small density window for the extended sets. Without
    // this, flat areas repeat one wide-stroke glyph and read as solid lines.
    float jitter = 0.0;
    if (glyphSet > 0) {
        float h = fract(sin(dot(cellIndex, float2(12.9898, 78.233))) * 43758.5453);
        jitter = (h - 0.5) * float(rampCount) * 0.06;
    }
    int rampIndex = clamp(int(luma * float(rampCount - 1) + jitter + 0.5), 0, rampCount - 1);
    int glyphIndex = int(kGlyphRamp[rampOffset + rampIndex]);

    float2 local = fract(sourcePx / cell);
    int gx = clamp(int(local.x * 8.0), 0, 7);
    int gy = clamp(int(local.y * 8.0), 0, 7);
    uint row = kGlyphFont[glyphIndex * 8 + gy];
    float on = float((row >> uint(gx)) & 1u);

    float3 glyphColor;
    if (u.colorMode < 0.5) {
        float mx = max(src.r, max(src.g, src.b));
        float3 hue = mx > 1e-4 ? src / mx : float3(1.0);
        glyphColor = mix(float3(luma), hue * (0.55 + 0.45 * luma), u.saturation);
    } else if (u.colorMode < 1.5) {
        glyphColor = float3(0.32, 1.0, 0.42);
    } else if (u.colorMode < 2.5) {
        glyphColor = float3(1.0, 0.68, 0.20);
    } else {
        glyphColor = float3(0.90, 0.95, 1.0);
    }
    glyphColor *= u.brightness;

    float3 bg = float3(u.background);
    float3 outColor = mix(bg, glyphColor, on);
    return float4(outColor, 1.0);
}
